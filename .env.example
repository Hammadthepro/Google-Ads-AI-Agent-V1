# Google Ads AI Agent — example configuration.
# Copy to .env (scripts/create-env.sh does this and generates APP_SECRET_KEY). NEVER commit .env.
# The app starts with every credential below left blank; features that need an integration say so until you configure it.
# Check your file any time (prints no values):   bash scripts/check-env.sh
# Fill blank values from your environment variables / Codespaces secrets: cd backend && python -m app.cli populate-env
#
# Credentials for Google Ads, GA4, Business Profile, Groq, Claude, Places and PageSpeed can also be entered on the
# Integrations page (encrypted in the database). Variables here are the fallback when nothing is saved there.
# Blank = use the default. Do not put quotes or spaces around values.

# --- Core --------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Safety ------------------------------------------------------
# Real Google Ads writes stay OFF. Key 1 of 2 is GOOGLE_ADS_WRITES_ENABLED; key 2 is a Super Admin authorisation in the app.
GOOGLE_ADS_WRITES_ENABLED=false
AUTO_NEGATIVES_MODE=shadow
AUTO_NEGATIVES_DAILY_LIMIT=25
EMERGENCY_BRAKE_WRITE_MODE=simulate

# --- Login -------------------------------------------------------
AUTH_PROVIDER=dev

# --- Infrastructure ----------------------------------------------
# Local / Docker Compose Postgres is the default. For Supabase use the Session Pooler URL with SSL, e.g.
#   postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Percent-encode special characters in the password (@ -> %40). COMPOSE_DATABASE_URL does the same for the Docker containers.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/google_ads_agent
COMPOSE_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Security ----------------------------------------------------
# APP_SECRET_KEY:       python -c "import secrets; print(secrets.token_urlsafe(48))"
# TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required (32+ random chars / a Fernet key) in production, and before saving credentials on the Integrations page.
APP_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=30

# --- App login (Google) ------------------------------------------
# Google SIGN-IN uses the Identity Services ID-token flow: only GOOGLE_CLIENT_ID is needed (no client secret, no redirect URI).
# Create an OAuth *Web* client in Google Cloud, add your app origin under 'Authorised JavaScript origins', then set AUTH_PROVIDER=google (dev = email login for existing users, local only).
# This is NOT the Google Ads OAuth client below. BOOTSTRAP_ADMIN_EMAIL becomes the first Super Admin; everyone else is invited.
BOOTSTRAP_ADMIN_EMAIL=
ALLOWED_LOGIN_DOMAINS=
GOOGLE_CLIENT_ID=

# --- Google Ads --------------------------------------------------
# Google Ads API. NO developer token: Google sunset them on 2026-09-09. API access levels (Test / Explorer / Basic / Standard)
# belong to the Google Cloud project that owns the OAuth client below; see the Google Ads API Overview page in Cloud Console.
# Test access calls TEST accounts only; a non-test account needs a higher level. Keyword Planner needs Basic or Standard.
# OAuth client = where you authorise Ads (different from the sign-in client above).
# GOOGLE_ADS_LOGIN_CUSTOMER_ID is optional: the manager (MCC) is chosen on the Integrations page and client accounts are discovered from it.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Website research --------------------------------------------
# Optional. PageSpeed works without a key at a low quota.
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# --- AI (Groq) ---------------------------------------------------
# Groq needs GROQ_API_KEY and GROQ_MODEL (exact Groq model ID, https://console.groq.com/docs/models).
# Which models you can use depends on your Groq plan (e.g. the Llama models are Enterprise-only for some accounts).
# The Integrations page lists what your key can use and sends a real JSON-mode request to each model before it is activated.
# Use a different model family for GROQ_CHALLENGER_MODEL than for GROQ_MODEL so the critic is independent.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_CHALLENGER_MODEL=

# --- AI (Claude) -------------------------------------------------
# Optional fallback for the Claude integration; the model is chosen on the Integrations page (default claude-opus-5-5).
ANTHROPIC_API_KEY=

# --- Email -------------------------------------------------------
# Alert emails are sent when SMTP_HOST is set; otherwise alerts stay in the app and are marked as not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@localhost

# --- Mock & crawler ----------------------------------------------
CRAWLER_MAX_PAGES=40
CRAWLER_MAX_DEPTH=2
CRAWLER_TIMEOUT_SECONDS=10
