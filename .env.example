# Google Ads AI Agent V1 — example configuration.
# Copy to .env and fill in locally. NEVER commit .env.
# The app runs fully in mock mode with every credential below left blank.

# --- Core ---
APP_ENV=development
INTEGRATION_MODE=mock
TEST_MODE=true
LOG_LEVEL=INFO

# --- Safety (real Google Ads writes stay OFF) ---
GOOGLE_ADS_WRITES_ENABLED=false
AUTO_NEGATIVES_MODE=shadow
AUTO_NEGATIVES_DAILY_LIMIT=25
EMERGENCY_BRAKE_WRITE_MODE=simulate

# --- Per-integration modes (inherit INTEGRATION_MODE when blank) ---
GOOGLE_ADS_MODE=
KEYWORD_RESEARCH_MODE=
PLACES_MODE=
PAGESPEED_MODE=
CRAWLER_MODE=fixture
NOTIFIER_MODE=
AUTH_PROVIDER=mock
AI_PROVIDER=mock

# --- Infrastructure ---
# Docker Compose / Codespaces containers use COMPOSE_DATABASE_URL (default: the bundled postgres service).
# Set it to the Supabase URL below to run the containers against Supabase.
COMPOSE_DATABASE_URL=
# Local / Docker Compose Postgres:
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/google_ads_agent
# Supabase (primary production database) — Session Pooler, SSL required. Percent-encode special
# characters in the password (e.g. @ -> %40). Never commit the real value.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=30

# --- App login (Google OIDC; not needed in mock mode) ---
BOOTSTRAP_ADMIN_EMAIL=
ALLOWED_LOGIN_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Google Ads (future real adapter; not needed in mock mode) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# --- Other Google APIs (future) ---
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# --- AI (Groq) ---
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_CHALLENGER_MODEL=

# --- Mock / crawler ---
MOCK_SEED=42
CRAWLER_MAX_PAGES=40
CRAWLER_MAX_DEPTH=2
CRAWLER_TIMEOUT_SECONDS=10
