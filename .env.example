# Google Ads AI Agent V1 — example configuration.
# Copy to .env and fill in locally. NEVER commit .env.
# The app runs fully in mock mode with every credential below left blank.

# --- Core ---
APP_ENV=development
INTEGRATION_MODE=mock
TEST_MODE=true
LOG_LEVEL=INFO

# --- Safety (real Google Ads writes stay OFF) ---
GOOGLE_ADS_WRITES_ENABLED=false
AUTO_NEGATIVES_MODE=shadow
AUTO_NEGATIVES_DAILY_LIMIT=25
EMERGENCY_BRAKE_WRITE_MODE=simulate

# --- Per-integration modes (inherit INTEGRATION_MODE when blank) ---
GOOGLE_ADS_MODE=
KEYWORD_RESEARCH_MODE=
PLACES_MODE=
PAGESPEED_MODE=
CRAWLER_MODE=fixture
NOTIFIER_MODE=
AUTH_PROVIDER=mock
AI_PROVIDER=mock

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://app:change-me@postgres:5432/google_ads_agent
REDIS_URL=redis://redis:6379/0
APP_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false

# --- App login (Google OIDC; not needed in mock mode) ---
BOOTSTRAP_ADMIN_EMAIL=
ALLOWED_LOGIN_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Google Ads (future real adapter; not needed in mock mode) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# --- Other Google APIs (future) ---
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# --- AI (Groq) ---
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_CHALLENGER_MODEL=

# --- Mock / crawler ---
MOCK_SEED=42
CRAWLER_MAX_PAGES=40
CRAWLER_MAX_DEPTH=2
CRAWLER_TIMEOUT_SECONDS=10
